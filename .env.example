# BPSR_HOST: Hostname to bind the HTTP/WS server.
# Why: Default to loopback for local-only usage.
# Empty => defaults to 127.0.0.1
BPSR_HOST=127.0.0.1

# BPSR_PORT: Port to bind. Use 0 to auto-pick a free port.
# Why: Avoid killing other processes and allow flexible startups.
# Empty/0 => auto-pick starting at BPSR_PORT_BASE
BPSR_PORT=0

# BPSR_PORT_BASE: Base port to start scanning when BPSR_PORT=0.
# Why: Consistent local development defaults.
# Empty => defaults to 8989
BPSR_PORT_BASE=8989

# BPSR_ENABLE_LAN: Expose to LAN (0.0.0.0) instead of loopback.
# Why: Optional opt-in for multi-device viewing.
# Empty/false => LAN disabled (local-only)
BPSR_ENABLE_LAN=false

# BPSR_REQUIRE_TOKEN: Require x-bpsr-token for /api/* and WS auth.
# Why: Prevent unauthorized local/LAN access.
# Empty/false => no token required (NOT recommended)
BPSR_REQUIRE_TOKEN=true

# BPSR_API_TOKEN: Static API token used if REQUIRE_TOKEN=true.
# Why: Simple shared-secret for local/LAN protection.
# Empty => a token is auto-generated and persisted (never logged)
BPSR_API_TOKEN=

# BPSR_ALLOWED_ORIGINS: Comma-separated list of allowed CORS origins.
# Why: Restrict cross-origin access (mandatory when LAN is enabled).
# Empty => only localhost/127.0.0.1 are allowed
BPSR_ALLOWED_ORIGINS=

# BPSR_DATA_DIR: Absolute directory for app data (settings/logs).
# Why: Confinement and safe filesystem operations.
# Empty => uses OS userData/bpsr (auto-created)
BPSR_DATA_DIR=

# BPSR_HISTORY_SAVE: Persist per-fight history to disk.
# Why: Optional audit/tracking for sessions.
# Empty/false => do not persist histories
BPSR_HISTORY_SAVE=false

# BPSR_FIGHT_LOG: Write detailed fight log lines to disk.
# Why: Optional detailed debugging/analysis.
# Empty/false => disabled by default
BPSR_FIGHT_LOG=false

# BPSR_LOG_RETENTION_DAYS: Days to keep rotated logs.
# Why: Disk hygiene and PII minimization.
# Empty => defaults to 7
BPSR_LOG_RETENTION_DAYS=7

# BPSR_RATE_WINDOW_MS: Rate-limit window for /api/* (milliseconds).
# Why: Throttle abusive/local scripts.
# Empty => defaults to 1000
BPSR_RATE_WINDOW_MS=1000

# BPSR_RATE_MAX: Max requests per window for /api/*.
# Why: Throttle abusive/local scripts.
# Empty => defaults to 60
BPSR_RATE_MAX=60

# BPSR_DEBUG: Enable limited binary dumps and extra logs.
# Why: Troubleshooting only, may include protocol blobs.
# Empty/0 => disabled (safe default)
BPSR_DEBUG=0

# BPSR_STARTUP_TIMEOUT_MS: Max time Electron waits for backend readiness.
# Why: Avoid false "server not responding" during slow boots.
# Empty => defaults to 15000
BPSR_STARTUP_TIMEOUT_MS=15000

# BPSR_HEALTH_PATH: Healthcheck HTTP path returning 200 when ready.
# Why: Electron polls this path to know when to load the UI.
# Empty => defaults to /healthz
BPSR_HEALTH_PATH=/healthz
